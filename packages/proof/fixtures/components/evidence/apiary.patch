   setFixture(fixture)
+  if (fixture.commands) {
+    const { seedHelp } = await import('./.foundation/help-environment')
+    seedHelp(fixture.commands)
+  }
   root.style.display = 'flex'
+  root.style.alignItems = fixture.rootAlign ?? 'stretch'
   const renderer = createRoot(root)
   renderer.render(createElement(Component, fixture.props))
+  await new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve())))
+  for (const [selector, id] of Object.entries(fixture.anchors ?? {})) {
+    const node = root.querySelector(selector)
+    if (!node) throw new Error(`Missing anchor: ${selector}`)
+    node.setAttribute('data-fdn-id', String(id))
+  }
+  if (fixture.expected && !root.textContent?.includes(fixture.expected)) throw new Error(`Missing fixture content: ${fixture.expected}`)
   return () => renderer.unmount()
 }
