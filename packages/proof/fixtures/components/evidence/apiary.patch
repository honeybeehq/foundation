diff --git a/.foundation/help-environment.ts b/.foundation/help-environment.ts
new file mode 100644
index 000000000..701251566
--- /dev/null
+++ b/.foundation/help-environment.ts
@@ -0,0 +1,10 @@
+import { CommandRegistry } from '../packages/core/src/commands'
+import { WorkspaceStore } from '../packages/store/src/kv'
+let app: any
+export function seedHelp(commandsFixture: { id: string; defaultKeys: string[] }[]): void {
+  const commands = new CommandRegistry()
+  for (const command of commandsFixture) commands.register({ ...command, title: command.id, category: 'Fixture', run: () => undefined })
+  const store = new WorkspaceStore()
+  app = { commands, roots: { settings: store.getMap('settings') } }
+}
+export const useApp = () => app
