+
+const noop = () => undefined
+const makeInbox = (selected: boolean) => {
+  const id = selected ? 'checkout-guest-cart' : 'pay-webhooks'
+  const prefix = `n249#${selected ? 1 : 0}::n249::`
+  return {
+    props: {
+      row: {
+        key: id,
+        entry: {
+          key: id,
+          session: { id, name: selected ? 'Checkout — guest cart merge' : id, agent: 'codex', model: 'gpt-6.1-sol', status: selected ? 'idle' : 'crashed', lastObservedState: 'dead' },
+          state: selected ? 'completed' : 'failed', failed: !selected,
+          blockingMinutes: selected ? 56 : 104, orderAt: 1785495600000,
+          priority: { band: selected ? 'completed' : 'immediate', score: 1, bottomed: false, reasons: [] },
+        },
+        dim: false, running: false, snoozed: false, bottomed: false, productLabel: null,
+      },
+      selected, entering: false, age: selected ? '56m' : '1h44',
+      finalMessage: selected ? 'drone-12 · +412 −96 · preview live' : undefined,
+      openQuestion: undefined, setRowRef: noop, onSelect: noop, onOpen: noop,
+    },
+    anchors: {
+      '[data-inbox-row]': prefix + 'n17',
+      '[data-inbox-row] > span:first-child > span:nth-child(2)': prefix + 'n20',
+      '[data-inbox-row] > span:first-child > span:nth-child(3)': prefix + 'n21',
+    },
+    expected: selected ? 'Checkout — guest cart merge' : id,
+    rootAlign: 'flex-start',
+  }
+}
+export const inboxSelected = makeInbox(true)
+export const inboxFailed = makeInbox(false)
+
+export const helpCenter = {
+  props: { contextViewType: 'hive.agent-run', onClose: noop },
+  commands: helpCommands,
+  anchors: { '[data-help-center]': 'n45' },
+  expected: 'Keyboard shortcuts',
+}
