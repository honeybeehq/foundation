@@ -0,0 +1,13 @@
+import ts from 'typescript'
+import fs from 'node:fs'
+import path from 'node:path'
+const root=process.cwd(), defs=new Map(), nodes=[]
+function files(dir) {return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?files(path.join(dir,e.name)):/\.tsx?$/.test(e.name)?[path.join(dir,e.name)]:[])}
+for(const file of [...files(root+'/apps/desktop/src/renderer/src'),root+'/packages/core/src/commands.ts']) {
+ const text=fs.readFileSync(file,'utf8'), tree=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true)
+ function walk(n){if(ts.isVariableDeclaration(n)&&ts.isIdentifier(n.name)&&n.initializer)defs.set(n.name.text,n.initializer);if(ts.isObjectLiteralExpression(n))nodes.push({file,node:n});ts.forEachChild(n,walk)}walk(tree)
+}
+function val(n,depth=0){if(!n||depth>15)return; if(ts.isStringLiteral(n)||ts.isNumericLiteral(n))return n.text;if(ts.isAsExpression(n)||ts.isParenthesizedExpression(n)||ts.isSatisfiesExpression(n))return val(n.expression,depth+1);if(ts.isIdentifier(n))return val(defs.get(n.text),depth+1);if(ts.isPropertyAccessExpression(n)){return val(n.expression,depth+1)?.[n.name.text]}if(ts.isArrayLiteralExpression(n)){const a=n.elements.flatMap(e=>ts.isSpreadElement(e)?val(e.expression,depth+1):[val(e,depth+1)]);return a.every(v=>v!==undefined)?a:undefined}if(ts.isObjectLiteralExpression(n)){return Object.fromEntries(n.properties.filter(ts.isPropertyAssignment).map(p=>[p.name.getText().replace(/['"]/g,''),val(p.initializer,depth+1)]))}}
+const found=new Map(), missed=[]
+for(const {file,node} of nodes){const p=Object.fromEntries(node.properties.filter(ts.isPropertyAssignment).map(p=>[p.name.getText().replace(/['"]/g,''),p.initializer]));if(!p.id||!p.defaultKeys)continue;const id=val(p.id),keys=val(p.defaultKeys);if(typeof id==='string'&&Array.isArray(keys)){found.set(id,{id,defaultKeys:keys,source:file.replace(root+'/','')})}else missed.push({file:file.replace(root+'/',''),id:p.id.getText(),keys:p.defaultKeys.getText()})}
+fs.writeFileSync(root+'/.foundation/help-commands.json',JSON.stringify([...found.values()].sort((a,b)=>a.id.localeCompare(b.id)),null,2)+'\n');fs.writeFileSync(root+'/.foundation/help-command-extraction.json',JSON.stringify({extracted:found.size,missed},null,2));console.log({extracted:found.size,missed})
