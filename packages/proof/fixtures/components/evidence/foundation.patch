+ const labels=csv(await readFile(`packages/proof/fixtures/ground-truth/${state}.defects.csv`,'utf8'))
+ for(const mode of ['ids','no-ids']) {
+  const source=`packages/proof/src/compare/evidence/round2/${state}-${mode}.json`
