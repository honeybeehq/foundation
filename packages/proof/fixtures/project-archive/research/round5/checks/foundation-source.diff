+import {it,expect} from 'vitest';
+import {chromium} from 'playwright';
+import {preserveCodeContext} from './code-context.ts';
+import {STYLE_PROPERTIES} from './dom.ts';
+it('normalizes a fixed-position card without reparenting it or shrinking its host',async()=>{
+ const browser=await chromium.launch();const page=await browser.newPage({viewport:{width:800,height:600}});
+ try {
+  await page.evaluate('globalThis.__name=f=>f');
+  await page.setContent('<style>body{margin:0}#foundation-root{width:100vw;height:100vh}#card{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:200px;height:100px}</style><div id="foundation-root"><section id="card">Code card</section></div>');
+  const audit=await preserveCodeContext(page,'#card',STYLE_PROPERTIES);
+  expect(audit.styleChanges).toHaveLength(0);expect(audit.geometryChanges).toHaveLength(0);
+  expect(audit.fixtureHost.frame.slice(2)).toEqual([800,600]);
+  expect((await page.locator('#card').boundingBox())?.x).toBeCloseTo(0);
+ } finally {await browser.close();}
+});
+it('preserves a focused input and scroll position while adding the isolation wrapper',async()=>{
+ const browser=await chromium.launch();const page=await browser.newPage({viewport:{width:800,height:600}});
+ try {
+  await page.evaluate('globalThis.__name=f=>f');
+  await page.setContent('<style>#foundation-root{width:800px;height:600px}#card{width:200px;height:100px;overflow:auto}input{border:1px solid gray}input:focus{border-color:blue}</style><div id="foundation-root"><section id="card"><input><div style="height:500px">Content</div></section></div>');
+  await page.locator('input').focus();await page.locator('#card').evaluate(el=>el.scrollTop=10);
+  const audit=await preserveCodeContext(page,'#card',STYLE_PROPERTIES);
+  expect(audit.focusRestored).toBe(true);expect(audit.styleChanges).toHaveLength(0);
+  expect(await page.locator('input').evaluate(el=>document.activeElement===el)).toBe(true);
+  expect(await page.locator('#card').evaluate(el=>el.scrollTop)).toBe(10);
+ } finally {await browser.close();}
+});
+it('does not turn fixture-root overflow into a zero-area clip on the synthetic wrapper',async()=>{
+ const browser=await chromium.launch();const page=await browser.newPage({viewport:{width:400,height:300}});
+ try {
+  await page.evaluate('globalThis.__name=f=>f');
+  await page.setContent('<style>#foundation-root{width:400px;height:300px;overflow:hidden}</style><div id="foundation-root"><section id="card" style="width:200px;height:100px"><button>Keep visible</button></section></div>');
+  await preserveCodeContext(page,'#card',STYLE_PROPERTIES);
+  expect(await page.locator('#foundation-root').evaluate(el=>getComputedStyle(el).overflow)).toBe('visible');
+ } finally {await browser.close();}
+});
diff --git a/packages/proof/src/capture/code-context.ts b/packages/proof/src/capture/code-context.ts
new file mode 100644
index 0000000..035c8a3
--- /dev/null
+++ b/packages/proof/src/capture/code-context.ts
@@ -0,0 +1,24 @@
+import type {Page} from 'playwright';
+import {preserveDesignContext} from './design-context.ts';
+
+/** Select a code component in place, preserving its ambient host dimensions. */
+export async function preserveCodeContext(page:Page,selector:string,properties:readonly string[]) {
+ const host=await page.evaluate(({selector,properties})=>{
+  const root=document.querySelector<HTMLElement>('#foundation-root');
+  const selected=document.querySelector<HTMLElement>(selector);
+  if(!root || !selected || root===selected || !root.contains(selected)) throw Error('Code context boundary must select one descendant of the fixture host');
+  if(document.querySelectorAll(selector).length!==1) throw Error('Code context boundary is ambiguous');
+  if(document.getElementById('foundation-code-host')) throw Error('Code context host marker already exists');
+  const nodes=[selected,...selected.querySelectorAll('*')],origin=selected.getBoundingClientRect();
+  const before=nodes.map(el=>{const box=el.getBoundingClientRect();return {box:[box.x-origin.x,box.y-origin.y,box.width,box.height],style:properties.map(p=>getComputedStyle(el).getPropertyValue(p))};});
+  const rect=root.getBoundingClientRect(),css=getComputedStyle(root);
+  const extra=(axis:'x'|'y')=>css.boxSizing==='border-box'?0:(axis==='x'?['paddingLeft','paddingRight','borderLeftWidth','borderRightWidth']:['paddingTop','paddingBottom','borderTopWidth','borderBottomWidth']).reduce((n,k)=>n+parseFloat(css[k as keyof CSSStyleDeclaration] as string||'0'),0);
+  root.style.width=`${rect.width-extra('x')}px`;root.style.height=`${rect.height-extra('y')}px`;root.id='foundation-code-host';
+  const afterOrigin=selected.getBoundingClientRect();
+  const changed=nodes.some((el,i)=>{const r=el.getBoundingClientRect(),b=before[i]!;return [r.x-afterOrigin.x,r.y-afterOrigin.y,r.width,r.height].some((v,j)=>Math.abs(v-b.box[j]!)>.05)||properties.some((p,j)=>getComputedStyle(el).getPropertyValue(p)!==b.style[j]);});
+  if(changed) throw Error('Code context changed while preserving the fixture host');
+  return {frame:[rect.x,rect.y,rect.width,rect.height],nodes:nodes.length};
+ },{selector,properties:[...properties]});
+ const isolation=await preserveDesignContext(page,selector,properties);
+ return {...isolation,fixtureHost:host};
+}
