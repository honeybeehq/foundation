diff --git a/.foundation/help-sample-atlas.ts b/.foundation/help-sample-atlas.ts
new file mode 100644
index 000000000..07f20a57c
--- /dev/null
+++ b/.foundation/help-sample-atlas.ts
@@ -0,0 +1,22 @@
+import type {HelpSection,HelpRowRef} from '../apps/desktop/src/renderer/src/helpShortcuts'
+import type {HelpTopic} from '../apps/desktop/src/renderer/src/helpTopics'
+export * from '../apps/desktop/src/renderer/src/helpShortcuts'
+export type {HelpRow,HelpSection,HelpRowRef} from '../apps/desktop/src/renderer/src/helpShortcuts'
+export type {HelpInline,HelpTopic} from '../apps/desktop/src/renderer/src/helpTopics'
+export let HELP_SECTIONS: readonly HelpSection[] = []
+export let HELP_TOPICS: readonly HelpTopic[] = []
+export function setHelpSamples(samples: {sections: readonly HelpSection[];topics: readonly (Omit<HelpTopic,'group'> & {group:string})[]}): void {
+  HELP_SECTIONS = samples.sections
+  HELP_TOPICS = samples.topics.map(topic => {
+    if (topic.group!=='guide' && topic.group!=='reference') throw new Error(`Invalid sample topic group: ${topic.group}`)
+    return {...topic,group:topic.group}
+  })
+}
+export function sectionIdForViewType(viewType: string | null | undefined): string | null {
+  return HELP_SECTIONS.find(section => section.viewTypes?.includes(viewType ?? ''))?.id ?? null
+}
+export function findHelpRow(sectionId: string,rowId: string): HelpRowRef | null {
+  const section=HELP_SECTIONS.find(value=>value.id===sectionId)
+  const row=section?.rows.find(value=>value.id===rowId)
+  return section && row ? {section,row} : null
+}
