new file mode 100644
index 000000000..05fb31081
--- /dev/null
+++ b/.foundation/fixtures.ts
@@ -0,0 +1,29 @@
+import type { TrackDefinitionV2, TrackItem, TrackNode, TrackAttachment, TrackStateItem } from '../packages/core/src/index'
+import data from './design-data.json'
+const rows = data.spinerows
+function node(row: typeof rows[number]): TrackNode {
+  const base = { id: row.id, name: row.name }
+  switch (row.type) {
+    case 'review': return { ...base, type: 'review', denied: rows.filter(r => r.arm === 'DENIED').map(node) }
+    case 'deploy': return { ...base, type: 'deploy', target: { kind: 'nectar', label: 'review' } }
+    case 'ask': return { ...base, type: 'ask', question: row.detail, blocking: true }
+    case 'orchestrate': return { ...base, type: 'orchestrate', instruction: row.detail, subAgents: { max: 3, harness: 'claude' } }
+    default: return { ...base, type: 'action', instruction: row.detail }
+  }
+}
+const items: TrackItem[] = rows.filter(r => r.depth === '0').map(r => r.type === 'branch' ? { branch: ['A', 'B'].map(lane => rows.filter(r => r.lane === lane).map(node)) } : node(r))
+const definitions: TrackDefinitionV2[] = data.tracks.map((row, i) => ({ schemaVersion: 2, name: row.name, version: Number(row.version.slice(1)), items: i === 0 ? items : items.slice(0, i === 5 ? 3 : 4) }))
+const epoch = Date.parse('2026-07-31T12:00:00Z')
+const age = (minutes: number) => new Date(epoch - minutes * 60000).toISOString()
+const attachments: TrackAttachment[] = data.attached.map((bee, i) => {
+  const current = ['n3b', 'n2', 'n4'][i]
+  const runtimeNode = (entry: TrackNode): any => ({ ...entry, status: entry.id === current ? 'pending' : ['n1', 'n2', 'n3a'].includes(entry.id) ? 'done' : 'pending', updatedAt: age(Number.parseInt(bee.age)), history: [], subTasks: [], ...(entry.type === 'review' ? { denied: entry.denied?.map(runtimeNode) } : {}) })
+  return { schemaVersion: 2, track: 'review-and-ship', version: 3, bee: bee.name, beeId: bee.id, attachedAt: age(60), updatedAt: age(Number.parseInt(bee.age)), items: items.map(item => 'branch' in item ? { branch: item.branch.map(lane => lane.map(runtimeNode)) } : runtimeNode(item)) as TrackStateItem[], steps: [], exceptions: i === 0 ? [{ note: data.exceptions[0]!.what, at: age(9), stepId: 'n3a' }] : [], queue: i === 0 ? data.queued.map(q => ({ track: q.behind, queuedAt: age(2), queuedBy: q.name })) : [] }
+})
+const props = { pane: { id: 'foundation-tracks', viewType: 'hive.tracks', params: { track: 'review-and-ship' } }, focused: false, active: false }
+const base = { props, mirror: { definitions, attachments }, sessions: [], proposal: null }
+export const atRest = { ...base }
+export const trackSelected = { ...base }
+const beforeItems = items.map(item => 'branch' in item ? item : item.id === 'n5' ? { id: 'n5old', type: 'action' as const, name: 'Manual smoke test', instruction: 'superseded by the preview' } : item.type === 'review' ? { ...item, denied: undefined } : item)
+export const proposalPending = { ...base, mirror: { ...base.mirror, definitions: [{ ...definitions[0]!, items: beforeItems }, ...definitions.slice(1)] }, proposal: { definition: definitions[0], rationale: 'Publish preview after the gate; add Fix findings on denial; replace Manual smoke test', proposedAt: age(2), baseVersion: 3 } }
+export const empty = { ...base, mirror: { definitions: [], attachments: [] }, props: { ...props, pane: { ...props.pane, params: {} } } }
