@@ -0,0 +1,14 @@
+async function start(): Promise<void> {
+  const harness = await import('../foundation.harness')
+  const state = new URLSearchParams(location.search).get('state') ?? 'track-selected'
+  harness.prepare()
+  const fixtures = await import('./fixtures')
+  const key = ({ 'at-rest': 'atRest', 'track-selected': 'trackSelected', 'proposal-pending': 'proposalPending', empty: 'empty' } as const)[state as 'track-selected']
+  if (!key) throw new Error(`Unknown fixture ${state}`)
+  const { TracksPane } = await import('../apps/desktop/src/renderer/src/panes/TracksPane')
+  await harness.mount({ Component: TracksPane, fixture: fixtures[key], root: document.getElementById('foundation-root')!, state })
+  await document.fonts.ready
+  await new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve())))
+  Object.assign(window, { __foundationReady: true })
+}
+void start().catch(error => { Object.assign(window, { __foundationError: String(error) }); console.error(error) })
