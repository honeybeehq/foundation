+import base from './vite.config'
+import { createRequire } from 'node:module'
+import { resolve, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+const require = createRequire(import.meta.url)
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '../..')
+const sources = ['state', 'sessionsStore', 'tracksMirror', 'tracksProposal', 'keybindings']
+export default {
+  ...base,
+  root,
+  optimizeDeps: { include: ['@stylexjs/stylex', '@stylexjs/stylex/lib/stylex-inject'] },
+  build: { rollupOptions: { input: resolve(root, '.foundation/preview.html') } },
+  resolve: { ...base.resolve, dedupe: ['react', 'react-dom'], alias: [{ find: /^@stylexjs\/stylex$/, replacement: require.resolve('@stylexjs/stylex') }, { find: /^@stylexjs\/stylex\/lib\/stylex-inject$/, replacement: require.resolve('@stylexjs/stylex/lib/stylex-inject') }, { find: 'react', replacement: resolve(root, 'apps/next-desktop-beta/node_modules/react') }, { find: 'react-dom', replacement: resolve(root, 'apps/next-desktop-beta/node_modules/react-dom') }, ...sources.map(name => ({ find: resolve(root, `apps/desktop/src/renderer/src/${name}`), replacement: resolve(root, '.foundation/environment.ts') }))] },
+  plugins: [...base.plugins ?? [], {
+    name: 'foundation-boundaries', enforce: 'pre',
+    resolveId(source: string, importer?: string) {
+      if (!importer || !source.startsWith('.')) return
+      const full = resolve(dirname(importer.split('?')[0]!), source).replace(/\.tsx?$/, '')
+      if (sources.some(name => full === resolve(root, `apps/desktop/src/renderer/src/${name}`))) return resolve(root, '.foundation/environment.ts')
+    },
+  }],
+}
