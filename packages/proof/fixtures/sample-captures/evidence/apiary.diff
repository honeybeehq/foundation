@@ -0,0 +1,20 @@
+import { createElement, type ComponentType } from 'react'
+import { createRoot } from 'react-dom/client'
+import './packages/ui/src/base.css'
+import './apps/next-desktop-beta/node_modules/@fontsource/hanken-grotesk/latin-400.css'
+import './apps/next-desktop-beta/node_modules/@fontsource/hanken-grotesk/latin-500.css'
+import './apps/next-desktop-beta/node_modules/@fontsource/hanken-grotesk/latin-600.css'
+import './apps/next-desktop-beta/node_modules/@fontsource/ibm-plex-mono/latin-400.css'
+import { setFixture } from './.foundation/environment'
+
+export function prepare(): void {
+  Object.defineProperty(window, 'apiary', { configurable: true, value: new Proxy({}, { get: (_, method) => { throw new Error(`Unconfigured IPC: ${String(method)}`) } }) })
+}
+
+export async function mount({ Component, fixture, root }: { Component: ComponentType<any>; fixture: any; root: HTMLElement; state: string }): Promise<() => void> {
+  setFixture(fixture)
+  root.style.display = 'flex'
+  const renderer = createRoot(root)
+  renderer.render(createElement(Component, fixture.props))
+  return () => renderer.unmount()
+}
