+import base from './vite.config'
+import { resolve, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '../..')
+const sources = ['state', 'sessionsStore', 'tracksMirror', 'tracksProposal', 'keybindings']
+export default {
+  ...base,
+  root,
+  build: { rollupOptions: { input: resolve(root, '.foundation/preview.html') } },
+  resolve: { ...base.resolve, dedupe: ['react', 'react-dom'], alias: [{ find: 'react', replacement: resolve(root, 'apps/next-desktop-beta/node_modules/react') }, { find: 'react-dom', replacement: resolve(root, 'apps/next-desktop-beta/node_modules/react-dom') }, ...sources.map(name => ({ find: resolve(root, `apps/desktop/src/renderer/src/${name}`), replacement: resolve(root, '.foundation/environment.ts') }))] },
+  plugins: [...base.plugins ?? [], {
+    name: 'foundation-boundaries', enforce: 'pre',
+    resolveId(source: string, importer?: string) {
+      if (!importer || !source.startsWith('.')) return
+      const full = resolve(dirname(importer.split('?')[0]!), source).replace(/\.tsx?$/, '')
+      if (sources.some(name => full === resolve(root, `apps/desktop/src/renderer/src/${name}`))) return resolve(root, '.foundation/environment.ts')
+    },
+  }],
+}
